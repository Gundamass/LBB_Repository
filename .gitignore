# This git repository lives at /home/heqing, so ignore the whole home
# directory by default and only expose the LBB project files below.
*
.*

# Git metadata files that should be versioned.
!.gitignore
!.gitattributes

# Project docs and configs at repository root.
!README.md
!PIPELINE.md
!readme.md
!比赛.md
!requirements.txt
!config.yaml
!config.no_classic.thr001_nms0445.ensemble_seed123.yaml
!config.no_classic.thr001_nms0455.ensemble_seed123.yaml

# Project entry points and utility scripts.
!dataset.py
!model.py
!train.py
!inference.py
!evaluate_local_map.py
!generate_laptop_masks.py
!generate_sam2_laptop_masks.py
!postprocess_calibrated.py
!postprocess_with_laptop_mask.py
!tune_mask_postprocess.py

# Source package.
!src/
!src/**
src/__pycache__/
src/**/__pycache__/
src/*.py[cod]
src/**/*.py[cod]

# Selected checkpoint tracked via Git LFS.
!checkpoints/
!checkpoints/seed123/
!checkpoints/seed123/best_model.pt

# Generated/local project artifacts remain ignored.
outputs/
logs/
runs/
wandb/
mlruns/
tensorboard/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.log
*.pid
*.out
*.err

# Data, annotations, third-party repos, and local model assets are not committed.
初赛数据/
手标数据/
masks/
third_party/
dinov3/
sam2_checkpoints/

# Other large weights are ignored unless explicitly allowed above.
*.pt
*.pth
*.ckpt
*.safetensors
!checkpoints/seed123/best_model.pt

# Secrets and local overrides.
.env
.env.*
*.local
